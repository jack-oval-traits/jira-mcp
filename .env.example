# Copy to .env and fill in. Never commit .env — it holds two live credentials.
#
#   cp .env.example .env

COMPOSE_PROJECT_NAME=jira-mcp

# --- Jira Cloud -------------------------------------------------------------
# Where to send API calls, no trailing slash. Which one you want depends on the
# kind of API token below:
#
#   classic token -> https://your-org.atlassian.net
#   scoped token  -> https://api.atlassian.com/ex/jira/<cloudId>
#
# Scoped tokens do not work against a site URL, and a site URL does not reject
# them -- it ignores them and answers as if logged out, so searches come back
# empty instead of failing. The server checks this at startup and prints the
# gateway URL for your site if the credentials are refused.
#
# cloudId, if you need it:
#   curl -s https://your-org.atlassian.net/_edge/tenant_info
JIRA_BASE_URL=https://your-org.atlassian.net

# The account the API token below belongs to. The adapter authenticates as this
# user: it inherits their permissions and its writes carry their name.
JIRA_EMAIL=you@example.com

# Create at https://id.atlassian.com/manage-profile/security/api-tokens
# A scoped token needs read:jira-work and write:jira-work.
JIRA_API_TOKEN=

# Optional. Used by create_issue when the caller omits a project.
JIRA_DEFAULT_PROJECT=PROJ

# Dispatcher dashboard custom fields. These defaults are the IDs on the Area
# Volleyball Jira site; override them if this adapter is pointed at another
# Jira site where the same display names have different IDs.
JIRA_FIELD_LOOP_COUNT=customfield_10174
JIRA_FIELD_TIME_IN_STATUS=customfield_10173
JIRA_FIELD_ACTIVE_AGENT=customfield_10175
JIRA_FIELD_RUN_ID=customfield_10176
JIRA_FIELD_DISPATCHED_FROM=customfield_10177
JIRA_FIELD_LAST_HEARTBEAT=customfield_10178
JIRA_FIELD_SESSION_LINK=customfield_10180
# Optional until these Jira single-select fields have been created. Options:
# Codey Agent Tier = Fast, Standard, Complex
# Codey Agent Provider = Codex, Claude
JIRA_FIELD_CODEY_AGENT_TIER=
JIRA_FIELD_CODEY_AGENT_PROVIDER=

# --- This MCP server --------------------------------------------------------
# Shared secret clients send as `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
JIRA_MCP_TOKEN=

# Host-side bind for the published port. Keep this on loopback unless the server
# sits behind a reverse proxy that terminates TLS — the bearer token is the only
# thing in front of your Jira credentials. The container always listens on 8787
# internally regardless of what JIRA_MCP_PORT is set to.
JIRA_MCP_BIND_ADDRESS=127.0.0.1
JIRA_MCP_PORT=8787

# The startup credential probe (GET /myself). "off" boots without it — for CI
# or smoke tests with no real credentials. Leaving it on is what catches the
# scoped-token trap described under JIRA_BASE_URL, so leave it on in real use.
#JIRA_MCP_STARTUP_CHECK=off

# Log one JSON record per tool call with before/after token counts, so the
# savings can be tracked against real traffic instead of a one-off script. Off
# by default: it costs a few ms per call to encode, and the records carry JQL
# and issue keys into wherever stdout goes. Read them with
# scripts/measure_report.py.
#JIRA_MCP_MEASURE=1

# --- Reverse proxy (optional) -----------------------------------------------
# Only needed with compose.proxy.yaml. See "Behind a reverse proxy" in README.md.
#
# Public hostname the proxy serves this on. Must be set for the SDK's
# DNS-rebinding protection to accept proxied requests.
#JIRA_MCP_HOST=jira-mcp.example.com
#
# Name of the pre-existing external Docker network shared with the proxy.
#PROXY_NETWORK=web
